server {
    listen 8000;
    client_max_body_size 50m;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_set_header Connection "";

    location = / { return 200 "ok"; }
    location = /health { return 200 "ok"; }

    # Telegram
    location /${PROXY_SECRET}/telegram/ {
        proxy_set_header Host api.telegram.org;
        proxy_pass https://api.telegram.org/;
    }
    # OpenAI
    location /${PROXY_SECRET}/openai/ {
        proxy_set_header Host api.openai.com;
        proxy_pass https://api.openai.com/;
    }
    # Anthropic
    location /${PROXY_SECRET}/anthropic/ {
        proxy_set_header Host api.anthropic.com;
        proxy_pass https://api.anthropic.com/;
    }
    # Google Gemini
    location /${PROXY_SECRET}/gemini/ {
        proxy_set_header Host generativelanguage.googleapis.com;
        proxy_pass https://generativelanguage.googleapis.com/;
    }
    # OpenRouter
    location /${PROXY_SECRET}/openrouter/ {
        proxy_set_header Host openrouter.ai;
        proxy_pass https://openrouter.ai/;
    }
    # Groq
    location /${PROXY_SECRET}/groq/ {
        proxy_set_header Host api.groq.com;
        proxy_pass https://api.groq.com/;
    }

    location / { return 404; }
}
